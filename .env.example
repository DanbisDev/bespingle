# Documentation only: Go reads process environment variables and does not
# automatically load this file. Export values in your shell or configure them
# in your hosting service. Optional custom avatar uploads require bucket secrets.

# Local development defaults (Vite runs separately on port 5555).
HOST=127.0.0.1
PORT=6666
ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# For a production build served directly by Go, set the built frontend path.
# Docker already sets HOST=0.0.0.0, PORT=8080, and STATIC_DIR=/app/dist.
# STATIC_DIR=/absolute/path/to/bespingle/dist

# Railway provides PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# The HTTPS origin for RAILWAY_PUBLIC_DOMAIN is allowed by the server.
# Add custom domains with comma-separated exact origins (scheme + host + port,
# if nonstandard), without paths or trailing slashes.
# ALLOWED_ORIGINS=https://office.example.com

# Optional Railway bucket for custom avatars. Without these settings, the six
# default avatars still work and the selector explains uploads are unavailable.
# Use variable references from your bucket's Credentials tab. Never prefix
# these with VITE_ or expose them to clients/agents.
# AVATAR_BUCKET_ENDPOINT=${{avatars.ENDPOINT}}
# AVATAR_BUCKET_NAME=${{avatars.BUCKET}}
# AVATAR_BUCKET_ACCESS_KEY_ID=${{avatars.ACCESS_KEY_ID}}
# AVATAR_BUCKET_SECRET_ACCESS_KEY=${{avatars.SECRET_ACCESS_KEY}}
# AVATAR_BUCKET_REGION=${{avatars.REGION}}
# New Railway buckets use virtual-hosted URLs. For an older bucket whose
# Credentials tab specifically requires path-style URLs, set this to true.
# AVATAR_BUCKET_FORCE_PATH_STYLE=false
